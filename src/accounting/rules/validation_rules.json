{
  "version": "1.0",
  "description": "Configurable validation rules for financial statement extraction (V1-V4 tiers)",
  "rules": [
    {
      "rule_id": "V1-001",
      "rule_name": "Balance Sheet Equation",
      "tier": "V1",
      "description": "Total Actif = Total Capitaux Propres et Passifs",
      "formula": "total_assets == total_equity + total_liabilities",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "CRITICAL",
      "applicable_statements": ["bilan"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V1-002",
      "rule_name": "VNC Consistency",
      "tier": "V1",
      "description": "Valeur Nette Comptable = Valeur Brute - Amortissements - Provisions",
      "formula": "net_value == gross_value - depreciation - provisions",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "ERROR",
      "applicable_statements": ["bilan"],
      "standards": ["NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V1-003",
      "rule_name": "CR Net Income Equation",
      "tier": "V1",
      "description": "Resultat Net = Resultat d'Exploitation + Resultat Financier + Resultat Exceptionnel - Impots",
      "formula": "net_income == operating_income + financial_income + exceptional_income - taxes",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "CRITICAL",
      "applicable_statements": ["compte_resultat"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V1-004",
      "rule_name": "Subtotal Coherence",
      "tier": "V1",
      "description": "Each subtotal row = sum of its component rows",
      "formula": "subtotal == sum(components)",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "ERROR",
      "applicable_statements": ["bilan", "compte_resultat", "flux_tresorerie"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V1-005",
      "rule_name": "Variation Percentage",
      "tier": "V1",
      "description": "Reported variation = (N - N-1) / N-1 x 100",
      "formula": "variation_pct == (current - prior) / prior * 100",
      "tolerance": 0.5,
      "tolerance_min": 0.0,
      "severity": "WARNING",
      "applicable_statements": ["bilan", "compte_resultat"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V1-006",
      "rule_name": "Field Type Integrity",
      "tier": "V1",
      "description": "Numeric columns contain valid numbers",
      "formula": "is_numeric(value)",
      "tolerance": 0.0,
      "tolerance_min": 0.0,
      "severity": "ERROR",
      "applicable_statements": ["bilan", "compte_resultat", "flux_tresorerie"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V2-001",
      "rule_name": "Resultat Net Match (Bilan-CR)",
      "tier": "V2",
      "description": "Bilan Capitaux Propres > Resultat de l'exercice = CR bottom line (Resultat Net)",
      "formula": "bilan.resultat_exercice == cr.resultat_net",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "CRITICAL",
      "applicable_statements": ["bilan", "compte_resultat"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V2-002",
      "rule_name": "Tresorerie Match (Bilan-TFT)",
      "tier": "V2",
      "description": "Bilan Liquidites et equivalents = TFT Tresorerie de cloture",
      "formula": "bilan.tresorerie == tft.tresorerie_cloture",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "CRITICAL",
      "applicable_statements": ["bilan", "flux_tresorerie"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V2-003",
      "rule_name": "Report a Nouveau Continuity",
      "tier": "V2",
      "description": "Report a nouveau N = Report a nouveau N-1 + Resultat N-1 - Dividendes",
      "formula": "ran_current == ran_prior + resultat_prior - dividends",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "WARNING",
      "applicable_statements": ["bilan"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V3-001",
      "rule_name": "Negative Where Unexpected",
      "tier": "V3",
      "description": "Capital social, Immobilisations brutes should not be negative",
      "formula": "value >= 0",
      "tolerance": 0.0,
      "tolerance_min": 0.0,
      "severity": "WARNING",
      "applicable_statements": ["bilan"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true,
      "fields": ["capital_social", "immobilisations_brutes", "stocks"]
    },
    {
      "rule_id": "V3-002",
      "rule_name": "Null Operational Values",
      "tier": "V3",
      "description": "Chiffre d'affaires should not be zero for operating companies",
      "formula": "chiffre_affaires != 0",
      "tolerance": 0.0,
      "tolerance_min": 0.0,
      "severity": "WARNING",
      "applicable_statements": ["compte_resultat"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V3-003",
      "rule_name": "Magnitude Mismatch",
      "tier": "V3",
      "description": "All amounts in the same statement should be in the same order of magnitude",
      "formula": "max_magnitude - min_magnitude <= 6",
      "tolerance": 0.0,
      "tolerance_min": 0.0,
      "severity": "WARNING",
      "applicable_statements": ["bilan", "compte_resultat"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V3-004",
      "rule_name": "Suspicious Proportions",
      "tier": "V3",
      "description": "Creances clients should not exceed 2x CA, Stocks should not exceed CA",
      "formula": "ratio_within_bounds",
      "tolerance": 0.0,
      "tolerance_min": 0.0,
      "severity": "WARNING",
      "applicable_statements": ["bilan", "compte_resultat"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": false
    },
    {
      "rule_id": "V4-001",
      "rule_name": "Fonds de Roulement",
      "tier": "V4",
      "description": "FR = Capitaux permanents - Actif immobilise (expected positive)",
      "formula": "fr == capitaux_permanents - actif_immobilise",
      "tolerance": 0.0,
      "tolerance_min": 0.0,
      "severity": "INFO",
      "applicable_statements": ["bilan"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    },
    {
      "rule_id": "V4-002",
      "rule_name": "Tresorerie Nette Cross-Check",
      "tier": "V4",
      "description": "Tresorerie Nette = FR - BFR = Tresorerie Actif - Tresorerie Passif",
      "formula": "tn == fr - bfr",
      "tolerance": 0.01,
      "tolerance_min": 1.0,
      "severity": "INFO",
      "applicable_statements": ["bilan"],
      "standards": ["IFRS", "NCT", "SYSCOHADA"],
      "active": true
    }
  ]
}
