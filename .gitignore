# ------------------------------------------------------------------------------
# Machine Learning / OCR Local Weights & Caches
# ------------------------------------------------------------------------------
# Model files are too large for Git; we ignore local weights directories if used
models/
.cache/
.huggingface/
.surya/
.easyocr/

# ------------------------------------------------------------------------------
# Project Specific Local Data & OCR Outputs
# ------------------------------------------------------------------------------
# We ignore the contents of local data and output directories to prevent
# committing large PDFs, financial statements, images, or extracted JSONs.
# data/*
# !data/.gitkeep

# output/*
# !output/.gitkeep

# Runtime upload artifacts written by the API (per-document UUID dirs) — never commit.
output/uploads/
