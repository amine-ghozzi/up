# FinAlze backend — copy to `.env` and adjust. All vars are prefixed FINALZE_.
# Generate a real secret:  openssl rand -hex 32

FINALZE_SECRET_KEY=change-me--openssl-rand-hex-32

# Datastores (match docker-compose.yml)
FINALZE_DATABASE_URL=postgresql+asyncpg://finalze:finalze@localhost:5432/finalze
FINALZE_REDIS_URL=redis://localhost:6379/0
FINALZE_BROKER_URL=amqp://guest:guest@localhost:5672//
FINALZE_RESULT_BACKEND_URL=redis://localhost:6379/1

# API
FINALZE_ALLOWED_ORIGINS=["http://localhost:8501"]
FINALZE_MAX_UPLOAD_MB=25
FINALZE_DOCS_ENABLED=true
FINALZE_DEFAULT_ACCOUNTING_STANDARD=NCT

# Object storage (MinIO/S3) — enable when wiring uploads
# FINALZE_S3_ENDPOINT_URL=http://localhost:9000
# FINALZE_S3_BUCKET=finalze-documents
# FINALZE_S3_ACCESS_KEY=minioadmin
# FINALZE_S3_SECRET_KEY=minioadmin
# FINALZE_S3_SECURE=false
